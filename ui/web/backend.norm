package ui.web
import ui.RenderNode
import ui.LayoutBackend
import ui.LayoutSpec
import ui.ViewContent
import ui.web.internal.webNodeNew
import std.core.Exception

class WebBackend implements LayoutBackend {
  RenderNode createLayout(LayoutSpec specification) {
    WebLayoutNode(specification)
  }
  RenderNode create(ViewContent content) {
    String kind = switch content {
      case Text(_) {
        break "text"
      }
      case Button(_, _) {
        break "button"
      }
      case Input(_, _, _) {
        break "input"
      }
      case Multiline(_, _, _, _) {
        break "multiline"
      }
      case Toggle(_, _) {
        break "toggle"
      }
      case Component(_, _) {
        break "container"
      }
      case WidgetObject(_) {
        break "container"
      }
      case Native(_) {
        throw Exception(message: "native views are created by their descriptor")
      }
    }
    WebRenderNode(peer: webNodeNew(arg0: kind))
  }
}
